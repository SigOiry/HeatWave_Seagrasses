    "            width = 0.3, height = 0.3)\n",
    "# combined_plot\n",
    "\n",
    "ggsave(\"Paper/Figs/High_res/Quiberon_map.png\", combined_plot, width = 10, height = 10, dpi = 800)\n",
    "ggsave(\"Paper/Figs/Low_res/Quiberon_map.png\", combined_plot, width = 10, height = 10, dpi = 200)"
   ],
