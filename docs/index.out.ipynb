    "      }\n",
    "    }else{\n",
    "      \n",
    "      if (a>0 & Tide_type==\"flot\" ) {\n",
    "        Tide_table_aggregate[i,4]<-\"HT\"\n",
    "      }\n",
    "      if (a<0 & Tide_type==\"jusant\" ){\n",
    "        Tide_table_aggregate[i,4]<-\"LT\"\n",
