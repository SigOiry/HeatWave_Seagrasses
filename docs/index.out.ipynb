    "\n",
    "# Plot the SST over time\n",
    "sst %>%\n",
    "  filter(!is.na(sst)) %>%\n",
    "  ggplot(aes(x = time, y = sst - 273.15)) +\n",
    "  geom_point(alpha = 0.3) +\n",
    "  geom_smooth(method = \"glm\") +\n",
    "  labs(x = \"Time\", y = \"SST (°C)\", title = \"Mean SST around Quiberon Over Time\")\n",
    "\n",
    "\n",
    "#### HEATWAVE DETECTION ########\n",
    "\n",
    "df_heatwaveR <- sst %>% \n",
    "  rename(t = time,\n",
