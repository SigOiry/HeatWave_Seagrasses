    "temp_var_name <- \"adjusted_sea_surface_temperature\"\n",
    "temperature_data <- ncvar_get(nc, temp_var_name)\n",
    "\n",
    "# Get the longitude and latitude variables (adjust variable names if different)\n",
    "lon <- ncvar_get(nc, \"longitude\")\n",
