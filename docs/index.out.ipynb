    "    temp_lead = lead(temp),\n",
    "    missing_lead = lead(missing)\n",
    "  ) %>%\n",
    "  filter(!is.na(t_lead)) %>%\n",
    "  mutate(\n",
    "    # Determine linetype based on missingness of adjacent points\n",
    "    linetype = ifelse(missing & missing_lead, \"solid\", \"dashed\")\n",
    "  )"
