    "      if (a>0) {\n",
    "        Tide_type<-\"jusant\"\n",
    "        \n",
    "      }else{\n",
    "        Tide_type<-\"flot\"\n",
    "      }\n",
    "      \n",
    "    }\n",
    "    \n",
    "  }\n",
    "  names(Tide_table_aggregate)<-c('date','water_height',\"smooth\",'tide_step')\n",
