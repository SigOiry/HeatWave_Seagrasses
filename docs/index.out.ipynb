    "  theme_Bede_Map()+\n",
    "  labs(x=\"Longitude\",\n",
    "       y=\"Latitude\")+\n",
    "  scale_y_continuous(labels=scaleFUN)+\n",
    "  # theme(plot.margin = unit(c(0.0,0.0,0.0,0.0), \"cm\"),\n",
    "  #       axis.title = element_blank(),\n",
    "  #       axis.ticks = element_blank(),\n",
    "  #       panel.grid.major = element_blank(),\n",
