    "mean_sst_df$mean_sst_celsius <- mean_sst_df$mean_sst - 273.15\n",
    "\n",
    "\n",
    "\n",
    "# Plot the mean SST map\n",
    "ggplot() +\n",
    "  geom_tile(data = mean_sst_df,  mapping = aes(x = lon, y = lat, fill = mean_sst_celsius)) +\n",
