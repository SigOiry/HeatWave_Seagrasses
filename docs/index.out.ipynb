    "  }\n",
    "  \n",
    "  site_name_selected<-dist_roi_Tide[which(dist_roi_Tide$dist==min(dist_roi_Tide$dist)),]\n",
    "  site_id<-site_name_selected$code_tide[1]\n",
    "  \n",
