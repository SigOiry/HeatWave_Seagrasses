    "  Tide_table$`Time (UTC)`<-as.POSIXct(Tide_table$`Time (UTC)`, tryFormats = c(\"%Y-%m-%d %H:%M:%OS\",\n",
    "                                                                              \"%Y/%m/%d %H:%M:%OS\",\n",
