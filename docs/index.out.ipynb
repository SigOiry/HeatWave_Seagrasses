    "    scale_fill_manual(name = \"legend\",\n",
    "                      values = cols_fill) +\n",
    "    scale_color_manual(name = \"legend\",\n",
    "                       values = cols_col) +\n",
    "   ggforce::geom_mark_ellipse(data=max_air_temp_test,\n",
