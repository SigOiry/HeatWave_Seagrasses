    "                                  str_detect(Target_types,\"Healthy\") ~ \"Healthy_seagrass\",\n",
    "                                  str_detect(Target_types,\"Bleached\") ~ \"Bleached_seagrass\",\n",
    "                                  T ~ \"Other\")) %>% \n",
    "  dplyr::filter(Target_types %in% c(\"Bleached_seagrass\",\"Healthy_seagrass\")) %>% \n",
    "  vect()\n",
    "\n",
    "\n",
    "before <- img_list %>%  \n",
    "  dplyr::filter(str_detect(path,\"20210814\")) %>% \n",
    "  pull(path) %>% \n",
    "  Read_S2() %>% \n",
    "  crop(msk, mask = T) \n",
    "\n",
    "during <- img_list %>%  \n",
    "  dplyr::filter(str_detect(path,\"20210906\")) %>% \n",
    "  pull(path) %>% \n",
    "  Read_S2() %>% \n",
    "  crop(msk, mask = T) \n",
    "\n",
    "after <- img_list %>%  \n",
    "  dplyr::filter(str_detect(path,\"20211008\")) %>% \n",
    "  pull(path) %>% \n",
    "  Read_S2() %>% \n",
    "  crop(msk, mask = T) \n",
    "\n",
    "before_cor <- before -1000\n",
    "during_cor <- during - 1000\n",
    "after_cor <- after - 1000\n",
    "\n",
    "SPC_before <- 172.06*(before_cor$B08-before_cor$B04)/(before_cor$B08+before_cor$B04)-22.18\n",
    "SPC_during <- 172.06*(during_cor$B08-during_cor$B04)/(during_cor$B08+during_cor$B04)-22.18\n",
    "SPC_after <- 172.06*(after_cor$B08-after_cor$B04)/(after_cor$B08+after_cor$B04)-22.18\n",
    "\n",
    "names(SPC_before) <- \"SPC_before\"\n",
    "names(SPC_during) <- \"SPC_during\"\n",
    "names(SPC_after) <- \"SPC_after\"\n",
    "\n",
    "\n",
    "darkened_patches <- read_sf(\"Output/darkening_patches_SDI.shp\") %>% \n",
    "  rasterize(SPC_before)\n",
    "names(darkened_patches)<-\"IsDarkened\"\n",
    "\n",
    "stk <- c(SPC_before,SPC_during,SPC_after, darkened_patches) %>% \n",
    "  as.data.frame() %>% \n",
    "  pivot_longer(-IsDarkened, names_to = \"When\", values_to = \"SPC\") %>% \n",
    "  mutate(When = case_when(str_detect(When,\"before\") ~ \"Before\",\n",
    "                          str_detect(When, \"during\") ~ \"During\",\n",
    "                          str_detect(When, \"after\") ~ \"After\"),\n",
    "         IsDarkened = case_when(IsDarkened == 1 ~ \"Impacted\",\n",
    "                                T ~ \"Green\"))\n",
    "ggplot(stk)+\n",
    "  geom_boxplot(aes(x = IsDarkened, y = SPC, color = IsDarkened))+\n",
    "  facet_wrap(~When, ncol = 3)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "df_all_indice <- read.csv(\"Data/Sentinel2/df_all_spectra_GCP.csv\") %>% \n",
    "  mutate(SPC = 172.06*NDVI-22.18) %>% \n",
    "  dplyr::select(c(filename, Target_types,Raster,NDVI,GLI,SPC)) %>%\n",
    "  mutate(sum = NDVI + GLI + SPC) %>% \n",
    "  dplyr::distinct(sum, .keep_all = T) %>% \n",
    "  dplyr::select(-sum) %>% \n",
    "    dplyr::filter(NDVI > 0 ) %>% \n",
    "  mutate(GLI = GLI *2) %>% \n",
    "  pivot_longer(c(NDVI,SPC,GLI), names_to = \"Indices\", values_to = \"values\") %>% \n",
    "  mutate(date = case_when(Raster == \"After\" ~ (\"2021-09-06\"), \n",
    "                          T ~ (\"2021-09-01\")),\n",
    "         Indices = case_when(Indices == \"NDVI\" ~ \"NDVI\",\n",
    "                             Indices == \"SPC\" ~ \"SPC\",\n",
    "                             Indices == \"GLI\" ~ \"GLI\"),\n",
    "         Target_types = case_when(Target_types == \"Bleached_seagrass\" ~ \"GCPs Darkened in the field\",\n",
    "                                  T ~ \"GCPs Green in the Field\"),\n",
    "        Target_types = factor(Target_types, levels = c(\"GCPs Green in the Field\", \"GCPs Darkened in the field\")),\n",
    "        Indices = factor(Indices, levels = c(\"NDVI\", \"SPC\", \"GLI\"))\n",
    "  ) %>% \n",
    "  dplyr::filter(Indices == \"SPC\") %>% \n",
    "  dplyr::select(-c(filename,Indices,date)) %>% \n",
    "  rename(SPC = \"values\",\n",
    "         When = \"Raster\") %>% \n",
    "  mutate(When = case_when(When == \"After\" ~ \"During\",\n",
    "                          T ~ When))\n",
    "\n",
    "\n",
    "# coltab <- c(\"GCPs Darkened in the field\" = \"brown\", \"GCPs Green in the Field\" = \"darkgreen\")\n",
    "coltab <- c(\"Impacted\" = \"brown\", \"Not Impacted\" = \"darkgreen\")\n",
    "\n",
    "  \n",
    "plot_resilience <- c(SPC_after) %>% \n",
    "  terra::extract(GCP, bind = T) %>% \n",
    "  as_tibble() %>% \n",
    "   dplyr::select(-c(path,filename)) %>% \n",
    "   mutate(When = \"After\",\n",
    "         Target_types = case_when(Target_types == \"Bleached_seagrass\" ~ \"GCPs Darkened in the field\",\n",
    "                                  T ~ \"GCPs Green in the Field\")) %>% \n",
    "   rename(SPC = \"SPC_after\") %>% \n",
    "   rbind(df_all_indice) %>% \n",
    "   mutate(date = case_when(When == \"Before\" ~ \"2021-09-01\",\n",
    "                           When == \"During\" ~ \"2021-09-06\", \n",
    "                           When == \"After\" ~ \"2021-10-07\"),\n",
    "         Target_types = case_when(Target_types == \"GCPs Darkened in the field\" ~ \"Impacted\",\n",
    "                                  T ~ \"Not Impacted\"),\n",
    "          Target_types = as.factor(Target_types),\n",
    "         SPC = case_when(SPC > 100 ~ 100,\n",
    "                         T ~ SPC)\n",
    "          # Target_types = fct_relevel(Target_types, \"GCPs Green in the Field\", \"GCPs Darkened in the field\")\n",
    "          ) %>% \n",
    "  dplyr::filter(SPC > 0 ) %>% \n",
    "   ggplot()+\n",
    "  geom_boxplot(aes(x = Target_types, y = SPC, color = Target_types), show.legend = F)+\n",
    "    scale_color_manual(values = coltab, \n",
    "                       label = c(\"Unimpacted seagrasses\",\"Impacted seagrasses\")) +\n",
    "  facet_wrap(~date, nrow = 1)+\n",
    "  ylab(\"Seagrass Cover (%)\")+\n",
    "  xlab(\"Seagrass status\")+\n",
    "  # scale_x_discrete(breaks = c(\"No\", \"Yes\"))+\n",
