    "  )+\n",
    "  theme_Bede()\n",
    "\n",
    "\n",
    "Relative_NDVI <- NDVI %>% \n",
    "  dplyr::select(-c(Time_POS)) %>% \n",
    "  pivot_wider(names_from = \"Scenario\", values_from = \"value\") %>%\n",
    "  group_by(timeDiff,Experiment) %>%\n",
    "  reframe(Treatment = mean(Treatment ,na.rm = T),\n",
    "          Control = mean(Control,na.rm = T)) %>% \n",
